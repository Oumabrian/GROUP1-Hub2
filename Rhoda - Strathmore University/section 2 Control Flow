#Section 2: Control Flow 

# 1. Positive / Negative / Zero check

# Prompt the user to enter a number
number = int(input("Enter a number: "))

#loop through
if number > 0:
    print("Number is Positive")
elif number < 0:
    print("Number is Negative")
else:
    print("Number is Zero")

# 2. For loop skipping number 5
for i in range(1, 11):
    if i == 5:
        continue
    print(i, end=" ")
print("\n")  # New line after loop

# 3. match-case for day names (Python 3.10+)
day = 3
match day:
    case 1: print("Monday")
    case 2: print("Tuesday")
    case 3: print("Wednesday")
    case 4: print("Thursday")
    case 5: print("Friday")
    case 6: print("Saturday")
    case 7: print("Sunday")
    case _: print("Invalid day number")


